<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.holdingco.vault-ld-export</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/chris.bergeron/Docker/vault-ld-graph/venv/bin/python</string>
    <string>/Users/chris.bergeron/github/vault-ld/holdingco/kb_export.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- docker (homebrew) + system bins; the runner shells docker for the load -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Paired with com.holdingco.wiki-lint (09:15); this runs 5 min after so the
       lint pass and the RDF projection reflect the same vault state. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>20</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/chris.bergeron/Docker/vault-ld-graph/export.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/chris.bergeron/Docker/vault-ld-graph/export.err.log</string>
</dict>
</plist>
